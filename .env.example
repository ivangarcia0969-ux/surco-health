# ============================================
# Surco Health — variables de entorno
# ============================================
NODE_ENV=development

# ============================================
# Database (con pgcrypto activado)
# ============================================
DATABASE_URL="postgresql://surco:surco_dev_pass@localhost:5432/surco_health?schema=public"

# ============================================
# Redis (sesiones, BullMQ, rate-limit)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# JWT (generar con: openssl rand -base64 64)
# ============================================
JWT_SECRET="cambiame-genera-uno-con-openssl-rand-base64-64"
JWT_REFRESH_SECRET="cambiame-otro-distinto"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ============================================
# Encriptación de columnas sensibles (pgcrypto)
# CRÍTICO: si cambia esta clave, se pierden los datos encriptados
# Generar con: openssl rand -hex 32  (32 bytes hex = 64 chars)
# ============================================
ENCRYPTION_KEY="cambiame-openssl-rand-hex-32"

# ============================================
# API
# ============================================
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ============================================
# Web (Next.js)
# ============================================
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# ============================================
# Storage (MinIO local, S3 en prod)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=surco-health-files
S3_FORCE_PATH_STYLE=true

# ============================================
# Teleconsulta — Daily.co
# https://dashboard.daily.co/developers
# ============================================
DAILY_API_KEY=
DAILY_DOMAIN=

# ============================================
# WhatsApp Cloud API (recordatorios, gated por plan)
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_HOURS_BEFORE=24

# ============================================
# Stripe (suscripción del SaaS)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CLINICA=

# ============================================
# Wompi (pasarela Colombia para suscripción local)
# ============================================
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# ============================================
# Facturación electrónica Colombia (DIAN)
# Proveedor: Facture / Alegra / Siigo
# ============================================
FE_PROVIDER=facture
FE_API_KEY=
FE_TEST_MODE=true

# ============================================
# Worker
# ============================================
WORKER_ENABLED=true
